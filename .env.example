# Used both for `dotnet run` locally (ConnectionStrings__DefaultConnection, Jwt__*) and
# for `docker compose up` (the compose-style names below). Keep both in sync.

POSTGRES_PASSWORD=change-me-locally

# Local (non-compose) API run against postgres on localhost, e.g. for `dotnet ef database update`.
ConnectionStrings__DefaultConnection=Host=localhost;Port=5432;Database=familytree;Username=familytree;Password=change-me-locally
Jwt__Issuer=https://localhost:5001
Jwt__Audience=familytree-api
Jwt__SigningKey=generate-a-32-byte-random-value-do-not-commit-a-real-one

# docker compose variables (api service in docker-compose.yml)
JWT_ISSUER=http://localhost:5000
JWT_AUDIENCE=familytree-api
JWT_SIGNING_KEY=generate-a-32-byte-random-value-do-not-commit-a-real-one
SEED_TENANT_NAME=Al-Saqqa Family
SEED_TENANT_SLUG=al-saqqa
SEED_FAMILY_TREE_NAME=عائلة السقا
SEED_ADMIN_EMAIL=admin@example.com
SEED_ADMIN_PASSWORD=choose-a-strong-password

# The port the frontend is published on. Only needed if something else on this machine
# already holds 8080 — compose defaults to 8080 when this is unset.
# FRONTEND_PORT=8081
